#!/bin/bash

# Start an Omarchy (Hyprland) desktop for an xrdp session.
#
# xrdp-sesman runs this as the X server of an Xorg-type session (code=20,
# via omarchy-xrdp-xserver, sesman.ini [Xorg] param), with Xorg's
# arguments. It builds this stack, all as the logged-in user:
#
#   cage (headless, gives Hyprland the GPU render node)
#    └─ start-hyprland → Hyprland, rendering to a virtual HEADLESS-RDP output
#   omarchy-xrdp-backend: captures HEADLESS-RDP and serves it to xrdp's xup
#   module (the protocol xorgxrdp speaks) on xrdp's socket, so xrdp encodes
#   it with H.264/RemoteFX; injects keyboard and mouse
#   Xwayland :N on cage, so sesman's waitforx and xrdp-chansrv have the
#   X display they expect
#
# The session lasts as long as Hyprland does: logging out of Omarchy ends it.

set -uo pipefail

LIBDIR=${OMARCHY_XRDP_LIBDIR:-/usr/lib/omarchy-xrdp}
CAGE=${OMARCHY_XRDP_CAGE:-$LIBDIR/cage}

display=""
auth=""
geometry="1920x1080"
socket=""

while (($#)); do
  case $1 in
    :*) display=${1#:} ;;
    -auth) auth=$2; shift ;;
    -geometry) geometry=$2; shift ;;
    -socket) socket=$2; shift ;;
    -config | -logfile | -nolisten | -logverbose | -depth | -dpi) shift ;;
  esac
  shift
done

if [[ -z $display ]]; then
  echo "Usage: omarchy-xrdp-session :DISPLAY [-auth FILE] [-geometry WxH] [-socket PATH]" >&2
  exit 1
fi
# Where xrdp's xup module connects, as xorgxrdp computes it
socket=${socket:-${XRDP_SOCKET_PATH:-/run/xrdp/$(id -u)}/xrdp_display_$display}

# xrdp sends the real session size on connect; the backend resizes to it
width=${geometry%x*}
height=${geometry#*x}

# Per-user overrides in ~/.config/omarchy/xrdp.conf (SCALE is read by
# omarchy-xrdp-resize, DESKTOP by omarchy-xrdp-xserver)
KEYBOARD=""
RENDER_NODE=""
BACKEND_DEBUG=""
MAC_SHORTCUTS=""
CONSOLE=yes
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/xrdp.conf"
[[ -r $config ]] && source "$config"

# A Hyprland of this user that no omarchy-xrdp session started: their live
# local desktop (logged in at the machine's screens)
local_desktop() {
  local runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} lock dir sig pid
  for lock in "$runtime"/hypr/*/hyprland.lock; do
    dir=$(dirname "$lock")
    sig=$(basename "$dir")
    pid=$(sed -n 1p "$lock" 2>/dev/null)
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null || continue
    grep -qxF "$sig" "$runtime"/omarchy-xrdp/*/hyprland-instance 2>/dev/null && continue
    echo "$sig"
    return 0
  done
  return 1
}

# Attach to the live desktop instead of starting a second session of the
# same user, which would fight it over the systemd --user session
attach=${OMARCHY_XRDP_ATTACH:-}
if [[ -z $attach && $CONSOLE == yes ]]; then
  attach=$(local_desktop)
fi
if [[ -n $attach ]]; then
  exec "$LIBDIR/omarchy-xrdp-console" "$attach" ":$display" -geometry "$geometry" \
    -socket "$socket" ${auth:+-auth "$auth"}
fi

if [[ -z $RENDER_NODE ]]; then
  for node in /dev/dri/renderD*; do
    [[ -r $node && -w $node ]] && RENDER_NODE=$node && break
  done
fi

# sesman starts the X server with a bare environment, so recreate the
# session one that pam_systemd prepared for this login.
uid=$(id -u)
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$uid}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export OMARCHY_XRDP_DISPLAY=$display
export PATH="$LIBDIR/shims:$PATH:/usr/local/bin"
if [[ -r /etc/locale.conf ]]; then
  set -a
  source /etc/locale.conf
  set +a
fi
unset DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE

state="$XDG_RUNTIME_DIR/omarchy-xrdp/$display"
logdir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-xrdp"
rm -rf "$state"
mkdir -p "$state" "$logdir"
logfile="$logdir/session-$display.log"
if [[ -f $logfile ]] && (($(stat -c %s "$logfile") > 1048576)); then
  mv "$logfile" "$logfile.old"
fi
exec >>"$logfile" 2>&1
echo "----"

log() { echo "$(date '+%H:%M:%S') $*"; }

log "Starting Omarchy RDP session :$display ${width}x${height} render ${RENDER_NODE:-none}"

pids=()
hypr_sig=""
start_pid=""

# Apps Omarchy launches with uwsm-app live in these systemd --user slices
# rather than under Hyprland, so they outlive it unless stopped.
graphical_slices=(app-graphical.slice background-graphical.slice session-graphical.slice)
session_env=(WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
  OMARCHY_XRDP_DISPLAY OMARCHY_XRDP_LIBDIR
  XRDP_SESSION XRDP_SOCKET_PATH XRDP_PULSE_SINK_SOCKET XRDP_PULSE_SOURCE_SOCKET)

other_omarchy_sessions() {
  local dir
  for dir in "$XDG_RUNTIME_DIR"/omarchy-xrdp/*/; do
    [[ $dir == "$state/" ]] && continue
    [[ -f $dir/pid ]] && kill -0 "$(<"$dir/pid")" 2>/dev/null && return 0
  done
  return 1
}

cleanup() {
  trap - EXIT TERM INT HUP
  log "Stopping session"
  [[ -n $hypr_sig ]] && HYPRLAND_INSTANCE_SIGNATURE=$hypr_sig hyprctl dispatch 'hl.dsp.exit()' >/dev/null 2>&1

  # Hyprland survives cage going away, so stop it (and start-hyprland) directly
  local stop=("${pids[@]}")
  if [[ -n $start_pid ]]; then
    stop+=("$start_pid")
    stop+=($(pgrep -P "$start_pid"))
  fi
  kill "${stop[@]}" 2>/dev/null
  sleep 1
  kill -9 "${stop[@]}" 2>/dev/null

  # Undo what the session put into systemd --user, as uwsm does for local
  # sessions: its services, apps and environment
  if ! other_omarchy_sessions; then
    systemctl --user stop omarchy-xrdp-session.target "${graphical_slices[@]}" 2>/dev/null
    systemctl --user unset-environment "${session_env[@]}" 2>/dev/null
  fi
  rm -rf "$state"
  rm -f "$socket"
}
trap cleanup EXIT
trap 'exit 0' TERM INT HUP

# Retry a command every 0.1s, up to $1 times
wait_for() {
  local tries=$1
  shift
  while ((tries-- > 0)); do
    "$@" && return 0
    sleep 0.1
  done
  return 1
}

# Hyprland loads the user's normal Omarchy config, plus the RDP output rule
cat >"$state/hyprland.lua" <<EOF
-- Generated by omarchy-xrdp-session for RDP display :$display
dofile(os.getenv("HOME") .. "/.config/hypr/hyprland.lua")
$("$LIBDIR/omarchy-xrdp-resize" --rule "$width" "$height")
EOF

WLR_BACKENDS=headless \
  WLR_HEADLESS_OUTPUTS=1 \
  WLR_LIBINPUT_NO_DEVICES=1 \
  WLR_RENDER_DRM_DEVICE=$RENDER_NODE \
  "$CAGE" -- "$LIBDIR/omarchy-xrdp-compositor" "$state" &
cage_pid=$!
pids+=("$cage_pid")

if ! wait_for 100 test -s "$state/start-pid"; then
  log "cage did not start"
  exit 1
fi
host_wayland=$(<"$state/host-wayland")
start_pid=$(<"$state/start-pid")

# The Hyprland instance is the one whose parent is our start-hyprland. Read
# the instance lock files (pid, then Wayland socket) rather than
# `hyprctl instances`, which chokes on stale instance directories.
hypr_instance() {
  local lock pid sock
  for lock in "$XDG_RUNTIME_DIR"/hypr/*/hyprland.lock; do
    { read -r pid && read -r sock; } <"$lock" 2>/dev/null || continue
    if [[ -n $sock && $(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') == "$start_pid" ]]; then
      hypr_sig=$(basename "$(dirname "$lock")")
      hypr_wayland=$sock
      return 0
    fi
  done
  return 1
}
if ! wait_for 200 hypr_instance; then
  log "Hyprland did not start"
  exit 1
fi
export HYPRLAND_INSTANCE_SIGNATURE=$hypr_sig
echo "$hypr_sig" >"$state/hyprland-instance"
echo "$hypr_wayland" >"$state/wayland"
log "Hyprland up: $hypr_sig on $hypr_wayland"

rdp_output_ready() {
  hyprctl -j monitors 2>/dev/null | jq -e 'any(.[]; .name == "HEADLESS-RDP")' >/dev/null
}
hyprctl output create headless HEADLESS-RDP >/dev/null
if ! wait_for 50 rdp_output_ready; then
  log "Could not create the HEADLESS-RDP output"
  exit 1
fi

# Start Omarchy's session services (graphical-session.target) with this
# session's Wayland environment; Omarchy's autostart imports the rest
WAYLAND_DISPLAY=$hypr_wayland systemctl --user import-environment \
  WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
  XDG_SESSION_TYPE OMARCHY_XRDP_DISPLAY
systemctl --user start --no-block omarchy-xrdp-session.target

backend_args=(--socket "$socket" --resize-cmd "$LIBDIR/omarchy-xrdp-resize")
[[ -n $BACKEND_DEBUG ]] && backend_args=(-v "${backend_args[@]}")

# The RDP client draws the cursor (no lag); Hyprland's own becomes invisible
read -r cursor_theme cursor_size < <("$LIBDIR/omarchy-xrdp-cursor" hide)
start_backend() {
  rm -f "$socket"
  WAYLAND_DISPLAY=$hypr_wayland OMARCHY_XRDP_KEYBOARD=$KEYBOARD \
    OMARCHY_XRDP_CURSOR_THEME=$cursor_theme OMARCHY_XRDP_CURSOR_SIZE=$cursor_size \
    OMARCHY_XRDP_MAC_SHORTCUTS=$MAC_SHORTCUTS \
    "$LIBDIR/omarchy-xrdp-backend" "${backend_args[@]}" &
  backend_pid=$!
  pids+=("$backend_pid")
  wait_for 50 test -S "$socket"
}
if ! start_backend; then
  log "omarchy-xrdp-backend did not start"
  exit 1
fi

# The X display xrdp waits for. Started last, so the session only reports
# ready once the backend is listening.
WAYLAND_DISPLAY=$host_wayland Xwayland ":$display" -geometry 1024x768 -noreset -nolisten tcp ${auth:+-auth "$auth"} &
pids+=($!)
if ! wait_for 50 test -S "/tmp/.X11-unix/X$display"; then
  log "Xwayland did not start"
  exit 1
fi

echo $$ >"$state/pid"
log "Session ready"

# Running and not a zombie (cage doesn't reap start-hyprland when it exits)
alive() {
  local stat
  stat=$(<"/proc/$1/stat") 2>/dev/null || return 1
  stat=${stat##*) }
  [[ ${stat%% *} != Z ]]
}

# The session lasts as long as Hyprland: Omarchy logout ends it. Keep the
# backend up meanwhile, since xrdp reconnects to the same socket.
restarts=0
while alive "$cage_pid" && alive "$start_pid"; do
  if ! alive "$backend_pid"; then
    if ((++restarts > 5)); then
      log "omarchy-xrdp-backend keeps exiting, ending session"
      exit 1
    fi
    log "omarchy-xrdp-backend exited, restarting ($restarts)"
    start_backend
  fi
  sleep 1
done
log "Hyprland exited"
