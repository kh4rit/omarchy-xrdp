#!/usr/bin/bash

# Configure xrdp to offer Omarchy (Hyprland) desktops.
#
#   omarchy-xrdp setup    Add the "Omarchy" session to xrdp (needs root)
#   omarchy-xrdp remove   Undo setup (needs root)
#   omarchy-xrdp status   Show configuration and running Omarchy RDP sessions
#
# setup adds an [Omarchy] section to xrdp.ini: an Xorg-type session (code=20)
# using xrdp's xup module, the protocol xorgxrdp speaks, so xrdp encodes it
# with H.264/RemoteFX. It points sesman's Xorg server at omarchy-xrdp-xserver
# (Omarchy for users with an Omarchy config, stock Xorg otherwise) and its
# default window manager at omarchy-xrdp-startwm, and hides xrdp.ini's own
# [Xorg] entry, which would now lead to the same place. Every change carries
# an "omarchy-xrdp" marker so remove (and a later setup) can undo it.

set -euo pipefail

LIBDIR=${OMARCHY_XRDP_LIBDIR:-/usr/lib/omarchy-xrdp}
XRDP_INI=${XRDP_INI:-/etc/xrdp/xrdp.ini}
SESMAN_INI=${SESMAN_INI:-/etc/xrdp/sesman.ini}
GFX_TOML=${GFX_TOML:-/etc/xrdp/gfx.toml}
MARK="; omarchy-xrdp"
GFX_MARK="# omarchy-xrdp"

need_root() {
  # OMARCHY_XRDP_NO_ROOT=1 lets tests run against copies of the ini files
  if ((EUID != 0)) && [[ -z ${OMARCHY_XRDP_NO_ROOT:-} ]]; then
    echo "omarchy-xrdp $1 needs root: sudo omarchy-xrdp $1" >&2
    exit 1
  fi
}

# Replace a file with the output of a filter, keeping ownership and mode
rewrite() {
  local file=$1 tmp
  shift
  tmp=$(mktemp "$file.XXXXXX")
  "$@" <"$file" >"$tmp"
  chmod --reference="$file" "$tmp"
  chown --reference="$file" "$tmp"
  mv "$tmp" "$file"
}

xrdp_ini_add() {
  # Insert the Omarchy session before the first session section so it is the
  # login screen's default, and comment out the [Xorg] section
  awk -v mark="$MARK" '
    function block() {
      print mark " begin"
      print "[Omarchy]"
      print "name=Omarchy"
      print "lib=libxup.so"
      print "username=ask"
      print "password=ask"
      print "port=-1"
      print "code=20"
      print "h264_frame_interval=16"
      print "rfx_frame_interval=32"
      print "normal_frame_interval=40"
      print mark " end"
      print ""
      done = 1
    }
    /^\[/ { in_xorg = ($0 == "[Xorg]") }
    !done && /^\[/ && !/^\[(Globals|Logging|LoggingPerLogger|Channels)\]/ { block() }
    in_xorg && $0 != "" { print mark " hid: " $0; next }
    { print }
    END { if (!done) { print ""; block() } }
  '
}

xrdp_ini_remove() {
  awk -v mark="$MARK" '
    $0 == mark " begin" { skip = 1; next }
    skip && $0 == mark " end" { skip = 0; dropblank = 1; next }
    skip { next }
    dropblank && /^$/ { dropblank = 0; next }
    index($0, mark " hid: ") == 1 { print substr($0, length(mark " hid: ") + 1); dropblank = 0; next }
    { dropblank = 0; print }
  '
}

# In section [$section], replace the first line starting with "$key=" (or
# the commented-out "#$key=" default) by "$key=$value", recording the
# original in a marker comment above it
sesman_set() {
  local section=$1 key=$2 value=$3
  awk -v mark="$MARK" -v section="[$section]" -v key="$key" -v value="$value" '
    /^\[/ { in_section = ($0 == section) }
    in_section && !done && (index($0, key "=") == 1 || index($0, "#" key "=") == 1) {
      print mark " was: " $0
      print key "=" value
      done = 1
      next
    }
    { print }
  '
}

sesman_restore() {
  awk -v mark="$MARK" '
    index($0, mark " was: ") == 1 { print substr($0, length(mark " was: ") + 1); skip_next = 1; next }
    skip_next { skip_next = 0; next }
    { print }
  '
}

# gfx.toml: put back lines an earlier version replaced (marker comments,
# TOML-style)
gfx_restore() {
  awk -v mark="$GFX_MARK" '
    index($0, mark " was: ") == 1 { print substr($0, length(mark " was: ") + 1); skip_next = 1; next }
    skip_next { skip_next = 0; next }
    { print }
  '
}

is_set_up() {
  grep -qxF "lib=libxup.so" <(sed -n "/^$MARK begin\$/,/^$MARK end\$/p" "$XRDP_INI") &&
    grep -qF "$LIBDIR/omarchy-xrdp-xserver" "$SESMAN_INI" &&
    grep -qx "XorgNoNewPrivileges=false" "$SESMAN_INI" &&
    { [[ ! -f $GFX_TOML ]] || ! grep -qF "$GFX_MARK" "$GFX_TOML"; }
}

reload_sesman() {
  # sesman re-reads sesman.ini on SIGHUP; xrdp reads xrdp.ini per connection
  if [[ -z ${OMARCHY_XRDP_NO_ROOT:-} ]] && systemctl is-active --quiet xrdp-sesman.service; then
    systemctl reload xrdp-sesman.service
  fi
}

setup() {
  need_root setup
  for file in "$XRDP_INI" "$SESMAN_INI"; do
    [[ -f $file ]] || { echo "Missing $file: is xrdp installed?" >&2; exit 1; }
  done
  if is_set_up; then
    echo "xrdp already offers the Omarchy session"
    return
  fi

  # Keep the very first backups: the files as they were before omarchy-xrdp
  [[ -e $XRDP_INI.omarchy-xrdp.bak ]] || cp -a "$XRDP_INI" "$XRDP_INI.omarchy-xrdp.bak"
  [[ -e $SESMAN_INI.omarchy-xrdp.bak ]] || cp -a "$SESMAN_INI" "$SESMAN_INI.omarchy-xrdp.bak"
  if [[ -f $GFX_TOML && ! -e $GFX_TOML.omarchy-xrdp.bak ]]; then
    cp -a "$GFX_TOML" "$GFX_TOML.omarchy-xrdp.bak"
  fi

  # Undo an earlier version of these changes first
  rewrite "$XRDP_INI" xrdp_ini_remove
  rewrite "$SESMAN_INI" sesman_restore

  rewrite "$XRDP_INI" xrdp_ini_add
  rewrite "$SESMAN_INI" sesman_set Globals DefaultWindowManager "$LIBDIR/omarchy-xrdp-startwm"
  rewrite "$SESMAN_INI" sesman_set Xorg param "$LIBDIR/omarchy-xrdp-xserver"
  # sesman starts the "X server" with no_new_privs, against a setuid Xorg.
  # Here that is the whole Omarchy session (Hyprland and every app), where
  # it would break sudo, pkexec and polkit. omarchy-xrdp-xserver runs the
  # plain, non-setuid /usr/lib/Xorg for other desktops.
  rewrite "$SESMAN_INI" sesman_set Security XorgNoNewPrivileges false
  # gfx.toml stays as xrdp ships it (0.6.0 set x264 to 4 threads, which
  # Windows App on macOS decodes with corruption): undo that if present.
  # The experimental FRAME_RATE above 60 may want more threads; see README.
  [[ -f $GFX_TOML ]] && rewrite "$GFX_TOML" gfx_restore

  reload_sesman
  echo "xrdp now offers the Omarchy session (default on the login screen)."
  echo "Backups: $XRDP_INI.omarchy-xrdp.bak, $SESMAN_INI.omarchy-xrdp.bak"
}

remove() {
  need_root remove
  rewrite "$XRDP_INI" xrdp_ini_remove
  rewrite "$SESMAN_INI" sesman_restore
  [[ -f $GFX_TOML ]] && rewrite "$GFX_TOML" gfx_restore
  reload_sesman
  echo "Removed the Omarchy session from xrdp."
}

status() {
  if is_set_up; then
    echo "xrdp: Omarchy session configured"
  else
    echo "xrdp: Omarchy session not configured (run: sudo omarchy-xrdp setup)"
  fi
  echo "services: xrdp $(systemctl is-active xrdp.service), xrdp-sesman $(systemctl is-active xrdp-sesman.service)"

  local found=0 dir user display
  for dir in /run/user/*/omarchy-xrdp/*/; do
    [[ -r $dir/pid ]] || continue
    kill -0 "$(<"$dir/pid")" 2>/dev/null || continue
    user=$(stat -c %U "$dir")
    display=$(basename "$dir")
    echo "session: $user on display :$display"
    found=1
  done
  ((found)) || echo "sessions: none visible (other users' sessions need root to see)"
}

case ${1:-} in
  setup) setup ;;
  remove) remove ;;
  status) status ;;
  *)
    echo "Usage: omarchy-xrdp setup | remove | status" >&2
    exit 1
    ;;
esac
