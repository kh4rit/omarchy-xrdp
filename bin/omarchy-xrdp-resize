#!/bin/bash

# Size an Omarchy RDP session's HEADLESS-RDP output.
#
#   omarchy-xrdp-resize --rule WIDTH HEIGHT   print the Hyprland monitor rule
#   omarchy-xrdp-resize WIDTH HEIGHT          apply it to the running session
#
# omarchy-xrdp-session uses --rule for the session's generated config, and
# omarchy-xrdp-vnc-proxy calls the second form when the RDP client changes
# size. Applying rewrites the rule in the generated config too, so a Hyprland
# reload keeps the new size.

set -euo pipefail

print_only=0
if [[ ${1:-} == --rule ]]; then
  print_only=1
  shift
fi

width=${1:-}
height=${2:-}
if [[ ! $width =~ ^[0-9]+$ || ! $height =~ ^[0-9]+$ ]]; then
  echo "Usage: omarchy-xrdp-resize [--rule] WIDTH HEIGHT" >&2
  exit 1
fi

SCALE=auto
FRAME_RATE=60
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/xrdp.conf"
[[ -r $config ]] && source "$config"

scale=$SCALE
if [[ $scale == auto ]]; then
  if ((width >= 3200)); then scale=2; elif ((width >= 2560)); then scale=1.5; else scale=1; fi
fi

# A live desktop already has monitors at 0x0: let Hyprland place it beside them
position=0x0
[[ -n ${OMARCHY_XRDP_CONSOLE:-} ]] && position=auto

output=${OMARCHY_XRDP_OUTPUT:-HEADLESS-RDP}
# The virtual monitor renders at least as often as frames are sent
refresh=60
[[ $FRAME_RATE =~ ^[0-9]+$ ]] && ((FRAME_RATE > 60 && FRAME_RATE <= 240)) && refresh=$FRAME_RATE
rule="hl.monitor({ output = \"$output\", mode = \"${width}x${height}@$refresh\", position = \"$position\", scale = $scale })"

if ((print_only)); then
  # A session's initial rule: record its scale for the backend
  initial_state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-xrdp/${OMARCHY_XRDP_DISPLAY:-}"
  [[ -n ${OMARCHY_XRDP_DISPLAY:-} && -d $initial_state ]] && echo "$scale" >"$initial_state/scale"
  echo "$rule"
  exit 0
fi

state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-xrdp/${OMARCHY_XRDP_DISPLAY:?not in an omarchy-xrdp session}"
# A console session (live desktop) has no generated config to keep in step
if [[ -f $state/hyprland.lua ]]; then
  sed -i "s|^hl\.monitor({ output = \"HEADLESS-RDP\".*|$rule|" "$state/hyprland.lua"
fi
# For the backend, which sizes the client-drawn cursor by it
echo "$scale" >"$state/scale"
hyprctl eval "$rule" >/dev/null

# Console mode (a live local desktop): keep the machine's own monitors dark
# while the desktop is in use remotely, and don't let the remote user's
# input wake them. Rerun after config reloads, which reset both.
if [[ -n ${OMARCHY_XRDP_CONSOLE:-} ]]; then
  hyprctl eval 'hl.config({ misc = { key_press_enables_dpms = false, mouse_move_enables_dpms = false } })' >/dev/null
  for monitor in $(hyprctl -j monitors | jq -r --arg o "$output" '.[] | select(.name != $o) | .name'); do
    hyprctl dispatch "hl.dsp.dpms({ action = \"off\", monitor = \"$monitor\" })" >/dev/null
  done
fi

# A config reload turns GSettings syncing back on, which would copy the
# invisible cursor theme into the user's GTK settings at the next cursor
# reload (e.g. a scale change)
if [[ -n ${OMARCHY_XRDP_CURSOR_THEME:-} ]]; then
  "$(dirname "$(readlink -f "$0")")/omarchy-xrdp-cursor" sync-off
fi
