#!/bin/bash

# Serve a user's live local desktop (the Hyprland already running on the
# machine's screens) to an xrdp session: "console mode".
#
# omarchy-xrdp-session hands over to this when the user who logs in over RDP
# already has a Hyprland running that omarchy-xrdp didn't start. It:
#   - adds a virtual HEADLESS-RDP monitor, sized to the RDP window, to that
#     Hyprland and moves the current workspace onto it;
#   - serves it with omarchy-xrdp-backend (keyboard, mouse, clipboard);
#   - starts a placeholder X display :N (Xwayland in a headless cage) for
#     sesman's waitforx and xrdp-chansrv;
#   - removes the monitor when the RDP session ends, which hands its
#     workspaces back to the real monitors.
# It never touches the local session's systemd --user environment or
# services.
#
# Usage: omarchy-xrdp-console INSTANCE_SIGNATURE :DISPLAY [Xorg-style args]

set -uo pipefail

LIBDIR=${OMARCHY_XRDP_LIBDIR:-/usr/lib/omarchy-xrdp}
CAGE=${OMARCHY_XRDP_CAGE:-$LIBDIR/cage}
OUTPUT=${OMARCHY_XRDP_OUTPUT:-HEADLESS-RDP}
export OMARCHY_XRDP_OUTPUT=$OUTPUT

instance=$1
shift
display=""
auth=""
geometry="1920x1080"
socket=""
while (($#)); do
  case $1 in
    :*) display=${1#:} ;;
    -auth) auth=$2; shift ;;
    -geometry) geometry=$2; shift ;;
    -socket) socket=$2; shift ;;
    -config | -logfile | -nolisten | -logverbose | -depth | -dpi) shift ;;
  esac
  shift
done
socket=${socket:-${XRDP_SOCKET_PATH:-/run/xrdp/$(id -u)}/xrdp_display_$display}
width=${geometry%x*}
height=${geometry#*x}

KEYBOARD=""
RENDER_NODE=""
BACKEND_DEBUG=""
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/xrdp.conf"
[[ -r $config ]] && source "$config"
if [[ -z $RENDER_NODE ]]; then
  for node in /dev/dri/renderD*; do
    [[ -r $node && -w $node ]] && RENDER_NODE=$node && break
  done
fi

uid=$(id -u)
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$uid}
export HYPRLAND_INSTANCE_SIGNATURE=$instance
export OMARCHY_XRDP_DISPLAY=$display
export OMARCHY_XRDP_CONSOLE=1
unset DISPLAY WAYLAND_DISPLAY

lock="$XDG_RUNTIME_DIR/hypr/$instance/hyprland.lock"
hypr_pid=$(sed -n 1p "$lock")
hypr_wayland=$(sed -n 2p "$lock")

state="$XDG_RUNTIME_DIR/omarchy-xrdp/$display"
logdir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-xrdp"
rm -rf "$state"
mkdir -p "$state" "$logdir"
logfile="$logdir/session-$display.log"
if [[ -f $logfile ]] && (($(stat -c %s "$logfile") > 1048576)); then
  mv "$logfile" "$logfile.old"
fi
exec >>"$logfile" 2>&1
echo "----"

log() { echo "$(date '+%H:%M:%S') $*"; }

wait_for() {
  local tries=$1
  shift
  while ((tries-- > 0)); do
    "$@" && return 0
    sleep 0.1
  done
  return 1
}

alive() {
  local stat
  stat=$(<"/proc/$1/stat") 2>/dev/null || return 1
  stat=${stat##*) }
  [[ ${stat%% *} != Z ]]
}

log "Attaching RDP display :$display to the live desktop $instance (${width}x${height})"
echo console >"$state/mode"
echo "$instance" >"$state/hyprland-instance"
echo "$hypr_wayland" >"$state/wayland"

# Whether input wakes the monitors: turned off while attached, restored after
option() { hyprctl -j getoption "misc:$1" 2>/dev/null | jq -r '.bool // .int // empty'; }
saved_key_dpms=$(option key_press_enables_dpms)
saved_mouse_dpms=$(option mouse_move_enables_dpms)

pids=()
cleanup() {
  trap - EXIT TERM INT HUP
  log "Detaching"
  kill "${pids[@]}" 2>/dev/null
  hyprctl output remove "$OUTPUT" >/dev/null 2>&1
  if alive "$hypr_pid"; then
    # As on Windows: the desktop is back on the machine's screens, locked
    hyprctl eval "hl.config({ misc = { key_press_enables_dpms = ${saved_key_dpms:-true}, mouse_move_enables_dpms = ${saved_mouse_dpms:-true} } })" >/dev/null
    hyprctl dispatch 'hl.dsp.dpms({ action = "on" })' >/dev/null
    hyprctl dispatch "hl.dsp.exec_cmd(\"${OMARCHY_XRDP_LOCK:-omarchy-system-lock}\")" >/dev/null
  fi
  sleep 1
  kill -9 "${pids[@]}" 2>/dev/null
  rm -rf "$state"
  rm -f "$socket"
}
trap cleanup EXIT
trap 'exit 0' TERM INT HUP

output_ready() {
  hyprctl -j monitors 2>/dev/null | jq -e --arg o "$OUTPUT" 'any(.[]; .name == $o)' >/dev/null
}

# A leftover from an earlier connection would keep the old size and rule
hyprctl output remove "$OUTPUT" >/dev/null 2>&1
hyprctl output create headless "$OUTPUT" >/dev/null
if ! wait_for 50 output_ready; then
  log "Could not create the $OUTPUT monitor"
  exit 1
fi
# Size it, and darken the machine's own monitors
"$LIBDIR/omarchy-xrdp-resize" "$width" "$height"
# Bring the workspace being worked on over to the RDP monitor
hyprctl dispatch "hl.dsp.workspace.move({ monitor = \"$OUTPUT\" })" >/dev/null

backend_args=(--socket "$socket" --output "$OUTPUT" --resize-cmd "$LIBDIR/omarchy-xrdp-resize")
[[ -n $BACKEND_DEBUG ]] && backend_args=(-v "${backend_args[@]}")
start_backend() {
  rm -f "$socket"
  WAYLAND_DISPLAY=$hypr_wayland OMARCHY_XRDP_KEYBOARD=$KEYBOARD \
    "$LIBDIR/omarchy-xrdp-backend" "${backend_args[@]}" &
  backend_pid=$!
  pids+=("$backend_pid")
  wait_for 50 test -S "$socket"
}
if ! start_backend; then
  log "omarchy-xrdp-backend did not start"
  exit 1
fi

# Placeholder X display :N for sesman and chansrv: Xwayland in a headless
# cage of its own, so nothing appears on the live desktop
WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_LIBINPUT_NO_DEVICES=1 \
  WLR_RENDER_DRM_DEVICE=$RENDER_NODE \
  "$CAGE" -- sh -c 'echo "$WAYLAND_DISPLAY" >"$1/host-wayland"; exec sleep infinity' sh "$state" &
cage_pid=$!
pids+=("$cage_pid")
if ! wait_for 100 test -s "$state/host-wayland"; then
  log "cage did not start"
  exit 1
fi
WAYLAND_DISPLAY=$(<"$state/host-wayland") \
  Xwayland ":$display" -geometry 1024x768 -noreset -nolisten tcp ${auth:+-auth "$auth"} &
pids+=($!)
if ! wait_for 50 test -S "/tmp/.X11-unix/X$display"; then
  log "Xwayland did not start"
  exit 1
fi

echo $$ >"$state/pid"
log "Console session ready"

# Lasts until the RDP session ends (sesman's SIGTERM) or the local desktop
# goes away (logout at the machine)
restarts=0
while alive "$hypr_pid" && alive "$cage_pid"; do
  if ! alive "$backend_pid"; then
    wait "$backend_pid"
    if (($? == 3)); then
      # Someone used the machine's own keyboard or mouse: like logging in
      # at a Windows console, that ends the remote session
      log "Local input at the machine, ending the remote session"
      exit 0
    fi
    if ((++restarts > 5)); then
      log "omarchy-xrdp-backend keeps exiting, ending session"
      exit 1
    fi
    log "omarchy-xrdp-backend exited, restarting ($restarts)"
    start_backend
  fi
  sleep 1
done
log "The local desktop is gone"
